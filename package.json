{
  "name": "go-web3-superbase",
  "version": "1.0.0",
  "description": "Ethereum event indexer with Supabase integration",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "indexer": "pnpm --filter @ethbucharest/evm-indexer start",
    "indexer:build": "pnpm --filter @ethbucharest/evm-indexer build",
    "indexer:test": "pnpm --filter @ethbucharest/evm-indexer test",
    "indexer:clean": "pnpm --filter @ethbucharest/evm-indexer clean",
    "backend": "cd packages/backend && export $(grep -v '^#' .env | xargs) && go run .",
    "backend:docs": "cd packages/backend && $HOME/go/bin/swag init",
    "backend:build": "cd packages/backend && go build -o bin/server",
    "backend:test": "cd packages/backend && go test ./...",
    "frontend:dev": "cd packages/frontend && pnpm dev",
    "frontend:build": "cd packages/frontend && pnpm build",
    "frontend:test": "cd packages/frontend && pnpm test",
    "frontend:clean": "cd packages/frontend && pnpm clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
